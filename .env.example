# ─────────────────────────────────────────────────────────────────────────────
#  AI Interviewer — example configuration
#  Copy to .env:  cp .env.example .env
#  Every value below is optional; the defaults produce a working demo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=AI Interviewer
# development | production | test
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Interview behaviour ──────────────────────────────────────────────────────
INTERVIEW_MIN_QUESTIONS=3
INTERVIEW_MAX_QUESTIONS=5
INTERVIEW_DEFAULT_QUESTIONS=4
INTERVIEW_MIN_ANSWER_CHARS=2
INTERVIEW_MAX_ANSWER_CHARS=4000
INTERVIEW_TOPIC_MAX_CHARS=160
INTERVIEW_CONTEXT_MAX_CHARS=300
INTERVIEW_LANGUAGE=English
# curious-researcher | friendly-peer | sharp-analyst
INTERVIEW_DEFAULT_PERSONA=curious-researcher
# Pipe-separated suggestions shown on the landing page.
INTERVIEW_SUGGESTED_TOPICS=AI in the workplace|productivity tools|scientific research|the future of education|remote work

# ── LLM provider ─────────────────────────────────────────────────────────────
# mock            No key needed. Deterministic demo interviewer (default).
# openai          api.openai.com
# openrouter      openrouter.ai
# groq            api.groq.com
# deepseek        api.deepseek.com
# mistral         api.mistral.ai
# together        api.together.xyz
# ollama          Local Ollama (OpenAI-compatible endpoint)
# lmstudio        Local LM Studio server
# vllm            Local vLLM server
# custom          Any OpenAI-compatible endpoint (set LLM_BASE_URL)
LLM_PROVIDER=mock
# Leave empty to use the provider's sensible default model.
LLM_MODEL=
# Required for hosted providers; ignored by mock and local servers.
LLM_API_KEY=
# Optional override. Required for LLM_PROVIDER=custom.
LLM_BASE_URL=
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# How many times to ask the model to repair invalid JSON (1-4).
LLM_JSON_ATTEMPTS=2
# Ask the API for native JSON mode. Some self-hosted servers reject this.
LLM_JSON_MODE=false

# ── Storage ──────────────────────────────────────────────────────────────────
# json (readable files, default) | memory (tests / ephemeral demos)
STORAGE_BACKEND=json
# Local development path. docker-compose overrides this to /data (named volume).
DATA_DIR=./data

# ── Local analysis (bonus) ───────────────────────────────────────────────────
ANALYSIS_ENABLED=true
ANALYSIS_KEYWORDS_TOP_N=8

# ── Docker Compose ports ─────────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000
OLLAMA_PORT=11434
# Backend uses this URL (inside the container) when the bundled Ollama profile
# is enabled. For a host-installed Ollama use http://host.docker.internal:11434/v1.
# LLM_BASE_URL=http://ollama:11434/v1


# ─────────────────────────────────────────────────────────────────────────────
#  Examples — uncomment one block (and remove the mock setting above).
# ─────────────────────────────────────────────────────────────────────────────
#
# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
#
# OpenRouter
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=sk-or-v1-...
#
# Groq
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
#
# DeepSeek
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
#
# Ollama on your host machine (Docker Desktop)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://host.docker.internal:11434/v1
#
# Bundled Ollama profile
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://ollama:11434/v1
#
# LM Studio on your host machine
# LLM_PROVIDER=lmstudio
# LLM_MODEL=your-model-name
# LLM_BASE_URL=http://host.docker.internal:1234/v1
#
# Any OpenAI-compatible server (vLLM, llama.cpp, LiteLLM, Together, ...)
# LLM_PROVIDER=custom
# LLM_MODEL=your-model
# LLM_BASE_URL=https://your-endpoint.example.com/v1
# LLM_API_KEY=optional
